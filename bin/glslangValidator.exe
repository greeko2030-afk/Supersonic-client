    def compile_shaders_to_spv(self):
        """ Translates GLSL shaders to SPIR-V using the bundled glslangValidator. """
        
        # Path to the bundled binary inside the 'bin' folder
        glslang_path = resource_path(os.path.join("bin", "glslangValidator.exe"))
        
        # Check if the binary exists
        if not os.path.exists(glslang_path):
            self.append_chat("System", "❌ Error: 'glslangValidator.exe' not found in bin/ folder.")
            return

        mc_dir = minecraft_launcher_lib.utils.get_minecraft_directory()
        shaderpacks_dir = os.path.join(mc_dir, "shaderpacks")
        
        if not os.path.exists(shaderpacks_dir):
            self.append_chat("System", "⚠️ Shaderpacks folder not found.")
            return

        self.append_chat("System", "⚙️ Compiling shaders to SPIR-V using bundled tool...")
        compiled_count = 0

        for root, dirs, files in os.walk(shaderpacks_dir):
            for file in files:
                if file.endswith((".vsh", ".fsh", ".glsl")):
                    input_path = os.path.join(root, file)
                    
                    # Defining output filename
                    if file.endswith(".vsh"):
                        new_filename = file.replace(".vsh", ".vert.spv")
                    elif file.endswith(".fsh"):
                        new_filename = file.replace(".fsh", ".frag.spv")
                    elif file.endswith(".glsl"):
                        new_filename = file.replace(".glsl", ".frag.spv")
                    else:
                        continue
                        
                    output_path = os.path.join(root, new_filename)
                    
                    # Using the bundled binary path
                    cmd = [glslang_path, "-V", input_path, "-o", output_path]
                    
                    try:
                        subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        self.append_chat("System", f"✅ Compiled: {file} -> {new_filename}")
                        compiled_count += 1
                    except subprocess.CalledProcessError:
                        self.append_chat("System", f"⚠️ Failed to compile: {file}. Syntax error.")

        if compiled_count > 0:
            self.append_chat("System", f"🎉 Successfully translated {compiled_count} shaders!")
        else:
            self.append_chat("System", "ℹ️ No shaders found to compile.")
