<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
  <dontWrapJar>false</dontWrapJar>
  <headerType>gui</headerType>
  <jar>minecraft/launcher.jar</jar>
  <outfile>Supersonic-Launcher.exe</outfile>
  <errTitle>Java Required - Supersonic Launcher</errTitle>
  <cmdLine></cmdLine>
  <chdir>.</chdir>
  <priority>high</priority>
  <downloadUrl>https://adoptium.net/temurin/releases/</downloadUrl>
  <supportUrl>https://www.narratormc.net</supportUrl>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  
  <singleInstance>
    <mutexName>SupersonicLauncher_Mutex</mutexName>
    <windowTitle></windowTitle>
  </singleInstance>

  <jre>
    <path></path>
    <bundledJre64Bit>false</bundledJre64Bit>
    <bundledJreAsFallback>false</bundledJreAsFallback>
    <minVersion>21.0.0</minVersion>
    <maxVersion></maxVersion>
    <jdkPreference>preferJre</jdkPreference>
    <runtimeBits>64</runtimeBits>
    <initialHeapSize>8192</initialHeapSize>
    <maxHeapSize>8192</maxHeapSize>
    
    <!-- Mesa3D DirectX 12 Optimization -->
    <opt>-Dorg.lwjgl.opengl.libname=opengl32.dll</opt>
    
    <!-- Max Optimized Java Arguments (ZGC) -->
    <opt>-XX:+UseZGC</opt>
    <opt>-XX:+ZGenerational</opt>
    <opt>-XX:+AlwaysPreTouch</opt>
    <opt>-XX:+DisableExplicitGC</opt>
    <opt>-XX:+PerfDisableSharedMem</opt>
    <opt>-XX:+UnlockExperimentalVMOptions</opt>
    <opt>-XX:MaxGCPauseMillis=10</opt>
    <opt>-XX:+UseStringDeduplication</opt>
    
    <!-- Ping & Network Optimization -->
    <opt>-Djava.net.preferIPv4Stack=true</opt>
    <opt>-DtcpNoDelay=true</opt>
  </jre>

  <versionInfo>
    <fileVersion>1.0.0.0</fileVersion>
    <txtFileVersion>1.0.0</txtFileVersion>
    <fileDescription>Supersonic Launcher - Official Client</fileDescription>
    <copyright>NarratorMC</copyright>
    <productVersion>1.0.0.0</productVersion>
    <txtProductVersion>1.0.0</txtProductVersion>
    <productName>Supersonic Launcher</productName>
    <internalName>SupersonicLauncher</internalName>
    <originalFilename>Supersonic-Launcher.exe</originalFilename>
  </versionInfo>
</launch4jConfig>
